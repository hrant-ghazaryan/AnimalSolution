<Window x:Class="AnimalWpf.AnimalCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalWpf"
        mc:Ignorable="d"
        Title="AnimalCreateWindow" Height="450" Width="800"
        Loaded="Window_Loaded">

    <Grid>
        <Label Content="Name" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="29" Margin="116,44,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.558,3.375"/>
        <Label Content="Weight" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="31" Margin="116,135,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.558,3.375"/>
        <Label Content="Gender" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="27" Margin="116,190,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.558,3.375"/>
        <Label Content="Age" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="28" Margin="116,88,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.558,3.375"/>
        <Label Content="Color" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="29" Margin="116,242,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.558,3.375"/>
        <TextBox HorizontalAlignment="Left" Height="29" Margin="232,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209"/>
        <TextBox HorizontalAlignment="Left" Height="28" Margin="232,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209"/>
        <TextBox HorizontalAlignment="Left" Height="31" Margin="232,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209"/>
        <ComboBox Name="genderComboBox" HorizontalAlignment="Left" Height="27" Margin="232,190,0,0" VerticalAlignment="Top" Width="209"/>
        <ComboBox Name="colorComboBox" HorizontalAlignment="Left" Height="27" Margin="232,244,0,0" VerticalAlignment="Top" Width="209"/>
        <Button Content="Create" HorizontalAlignment="Left" Height="29" Margin="262,312,0,0" VerticalAlignment="Top" Width="138"/>
        <Label Content="Lng" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="33" Margin="498,312,0,0" VerticalAlignment="Top" Width="37"/>
        <ComboBox Name="lngComboBox" SelectionChanged="SelectedLanguageChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="33" Margin="535,309,0,0" VerticalAlignment="Top" Width="57"/>
    </Grid>
</Window>
