<Window x:Class="AnimalWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalWpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="UserNameTextBox" HorizontalAlignment="Left" Height="34" Margin="312,42,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="136" />
        <TextBox x:Name="EmailTextBox" HorizontalAlignment="Left" Height="37" Margin="312,101,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="136"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Height="31" Margin="312,178,0,0"  VerticalAlignment="Top" Width="136"/>
        <PasswordBox x:Name="ConfirmPasswordBox" HorizontalAlignment="Left" Height="36" Margin="312,248,0,0" VerticalAlignment="Top" Width="136"/>

        <Button Content="Register" Click="RegisterButton_Click" HorizontalAlignment="Left" Height="31" Margin="253,317,0,0" VerticalAlignment="Top" Width="90"/>
        <Button Content="Login" Click="LoginButton_Click" HorizontalAlignment="Left" Height="31" Margin="410,317,0,0" VerticalAlignment="Top" Width="96"/>

        <Label Content="UserName" HorizontalAlignment="Left" Height="34" Margin="164,42,0,0" VerticalAlignment="Top" Width="115"/>
        <Label Content="Email" HorizontalAlignment="Left" Height="37" Margin="164,101,0,0" VerticalAlignment="Top" Width="115"/>
        <Label Content="Password" HorizontalAlignment="Left" Height="39" Margin="164,178,0,0" VerticalAlignment="Top" Width="115"/>
        <Label Content="Confirm Password" HorizontalAlignment="Left" Height="36" Margin="164,248,0,0" VerticalAlignment="Top" Width="115"/>
        
        <TextBlock x:Name="MessageTextBlock" HorizontalAlignment="Left" Height="79" Margin="547,138,0,0" TextWrapping="Wrap" Text="Result Message" VerticalAlignment="Top" Width="199"/>
    </Grid>
</Window>
