{
  "ReverseProxy": {
    "Routes": {
      "animal-api": {
        "ClusterId": "animal-cluster",
        "Match": {
          "Path": "/api/animals/{**catch-all}"
        }
      },
      "auth-api": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "translation-api": {
        "ClusterId": "translation-cluster",
        "Match": {
          "Path": "/api/translations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "animal-cluster": {
        "Destinations": {
          "animal-api": {
            "Address": "https://localhost:7150/"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "https://localhost:7184/"
          }
        }
      },
      "translation-cluster": {
        "Destinations": {
          "translation-api": {
            "Address": "https://localhost:7274/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
