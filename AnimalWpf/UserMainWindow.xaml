<Window x:Class="AnimalWpf.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalWpf"
        mc:Ignorable="d"
        Title="UserMainWindow" Height="450" Width="800">
    <Grid Margin="0,1,0,-1">
        <Button Content="Add Animal" HorizontalAlignment="Left" Height="37" Margin="10,154,0,0" VerticalAlignment="Top" Width="145" Click="AddAnimal_Click"/>
        <Button Content="Logout" HorizontalAlignment="Left" Margin="10,217,0,0" VerticalAlignment="Top" Height="37" Width="145" Click="Logout_Click"/>
        <Button Content="Users" HorizontalAlignment="Left" Height="37" Margin="10,96,0,0" VerticalAlignment="Top" Width="145" Click="Button_Click_1"/>
        <Button Content="Animals" HorizontalAlignment="Left" Height="34" Margin="10,43,0,0" VerticalAlignment="Top" Width="145" Click="Button_Click"/>

    </Grid>
</Window>
